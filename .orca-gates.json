{
  "version": 1,
  "components": [
    {
      "path": ".",
      "prefixes": [
        ""
      ],
      "dependencies": [
        ".venv"
      ],
      "commit": [
        [
          "uv",
          "run",
          "--no-sync",
          "ruff",
          "check",
          "."
        ],
        [
          "uv",
          "run",
          "--no-sync",
          "python",
          "scripts/check_python_format.py"
        ],
        [
          "uv",
          "run",
          "--no-sync",
          "python",
          "-m",
          "mypy"
        ]
      ],
      "push": [
        [
          "uv",
          "run",
          "--no-sync",
          "python",
          "-m",
          "pytest",
          "-q"
        ]
      ]
    },
    {
      "path": "macos/Translator",
      "prefixes": [
        "macos/Translator/",
        ".orca-gates.json"
      ],
      "commit": [
        [
          "swift",
          "build",
          "-c",
          "release",
          "--jobs",
          "1",
          "-Xswiftc",
          "-disable-batch-mode",
          "-Xswiftc",
          "-no-whole-module-optimization"
        ]
      ],
      "push": [
        [
          "scripts/swift-test.sh",
          "--jobs",
          "1",
          "-Xswiftc",
          "-disable-batch-mode"
        ]
      ]
    },
    {
      "path": "macos/AppleLangHelper",
      "prefixes": [
        "macos/AppleLangHelper/",
        ".orca-gates.json"
      ],
      "commit": [
        [
          "swift",
          "build",
          "-c",
          "release",
          "--jobs",
          "1",
          "-Xswiftc",
          "-disable-batch-mode",
          "-Xswiftc",
          "-no-whole-module-optimization"
        ]
      ],
      "push": [
        [
          "scripts/swift-test.sh",
          "--jobs",
          "1",
          "-Xswiftc",
          "-disable-batch-mode"
        ]
      ]
    },
    {
      "path": "web",
      "prefixes": [
        "web/"
      ],
      "dependencies": [
        "node_modules"
      ],
      "commit": [
        [
          "npm",
          "run",
          "check"
        ],
        [
          "npm",
          "run",
          "build"
        ]
      ],
      "push": [
        [
          "npm",
          "test",
          "--",
          "--maxWorkers=1"
        ]
      ]
    }
  ]
}
